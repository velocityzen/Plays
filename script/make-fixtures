#!/usr/bin/env bash
# Make the small media files in tests/fixtures, which tests open without
# the ffmpeg command line tool (the files are committed; run this only to
# change them). Takes ffmpeg with libx264.
#
# clip.mp4       160x120, 25 fps, 2 s, H.264 with B-frames, AAC sound
# clip-ip.mkv    the same picture with no B-frames, no sound
# clip-no-duration.mkv  12 s of clip-ip.mkv's picture, written through a
#                pipe so the file never says how long it is
# clip-one-key.mp4  6 s of the picture with a keyframe only at its start,
#                too few to cut copied video into segments at
# clip-opus.mkv  clip.mp4 with its sound as Opus, which a speaker taking
#                only AAC gets re-encoded
# clip-sound-gap.mkv  clip.mp4's picture with 1.6 s of Opus sound and
#                none from 0.6 s to 1 s, the rest playing from 1 s on
# tone.m4a       1 s of 440 Hz, AAC, no picture
# tune.flac      0.3 s of 440 Hz, 24-bit 96 kHz FLAC, tagged as Tone by
#                Plays on Fixtures, whose album artist is Various Artists;
#                after tone.m4a by name, so the files beside the others stay
# clip.srt       two cues, found beside clip.mp4
# clip-subs.mkv  clip.mp4 with clip.srt in it, as an English track
# clip-languages.mkv  clip.mp4 with its sound as English, a German tone
#                at 660 Hz, and clip.srt as English and French subtitles,
#                none of them a default
# clip-chapters.mkv  clip.mp4 in three chapters: Opening, Middle (from
#                0.8 s) and End (from 1.4 s)
# clip-dvdsub.mkv  clip.mp4 with DVD subtitles at clip.srt's cue times: a
#                white bar outlined in black, low in the picture for the
#                first cue and high for the second (written here as VobSub,
#                as FFmpeg turns only pictures into picture subtitles)
# clip-odd-colors.mkv  2 s of a flat 10-bit FFV1 picture whose Matroska
#                colors say primaries 15, transfer 40 and matrix 30,
#                numbers FFmpeg has no names for
set -euo pipefail

cd "$(dirname "$0")/../tests/fixtures"

ffmpeg=(ffmpeg -hide_banner -loglevel error -y)
picture=(-f lavfi -i "testsrc=size=160x120:rate=25:duration=2")
x264=(-c:v libx264 -pix_fmt yuv420p -preset veryslow -crf 36 -g 25)

"${ffmpeg[@]}" "${picture[@]}" \
    -f lavfi -i "sine=frequency=440:sample_rate=48000:duration=2" \
    "${x264[@]}" -bf 3 -c:a aac -b:a 32k -ac 1 -map_metadata -1 clip.mp4
"${ffmpeg[@]}" "${picture[@]}" \
    "${x264[@]}" -bf 0 -map_metadata -1 clip-ip.mkv
"${ffmpeg[@]}" -f lavfi -i "testsrc=size=160x120:rate=25:duration=12" \
    "${x264[@]}" -bf 0 -map_metadata -1 -f matroska - > clip-no-duration.mkv
"${ffmpeg[@]}" -f lavfi -i "testsrc=size=160x120:rate=25:duration=6" \
    -c:v libx264 -pix_fmt yuv420p -preset veryslow -crf 36 -g 1000 \
    -sc_threshold 0 -bf 0 -map_metadata -1 clip-one-key.mp4
"${ffmpeg[@]}" -i clip.mp4 -map 0 -c:v copy -c:a libopus -b:a 24k \
    -map_metadata -1 clip-opus.mkv
# Frames as long as Opus's, so each keeps its own time.
"${ffmpeg[@]}" -i clip.mp4 \
    -f lavfi -i "sine=frequency=440:sample_rate=48000:duration=1.6:samples_per_frame=960" \
    -filter:a "asetpts='if(gte(T,0.6),PTS+0.4/TB,PTS)'" -map 0:v -map 1:a \
    -c:v copy -c:a libopus -b:a 24k -ac 1 -map_metadata -1 clip-sound-gap.mkv
"${ffmpeg[@]}" -f lavfi -i "sine=frequency=440:sample_rate=48000:duration=1" \
    -c:a aac -b:a 32k -ac 1 -map_metadata -1 tone.m4a
"${ffmpeg[@]}" -f lavfi -i "sine=frequency=440:sample_rate=96000:duration=0.3" \
    -c:a flac -sample_fmt s32 -bits_per_raw_sample 24 -ac 1 -map_metadata -1 \
    -metadata title=Tone -metadata artist=Plays -metadata album=Fixtures \
    -metadata album_artist="Various Artists" tune.flac
cat > clip.srt <<'SRT'
1
00:00:00,200 --> 00:00:01,000
First

2
00:00:01,200 --> 00:00:01,900
Second
SRT
"${ffmpeg[@]}" -i clip.mp4 -i clip.srt -map 0 -map 1 -c copy -c:s srt \
    -metadata:s:s:0 language=eng -metadata:s:s:0 title=English \
    -map_metadata -1 clip-subs.mkv

sed -e 's/^First$/Premier/' -e 's/^Second$/Deuxième/' clip.srt > clip-fr.srt
"${ffmpeg[@]}" -i clip.mp4 \
    -f lavfi -i "sine=frequency=660:sample_rate=48000:duration=2" \
    -i clip.srt -i clip-fr.srt \
    -map 0:v -map 0:a -map 1:a -map 2 -map 3 \
    -c:v copy -c:a:0 copy -c:a:1 aac -b:a:1 32k -ac:a:1 1 -c:s srt \
    -metadata:s:a:0 language=eng -metadata:s:a:1 language=ger \
    -metadata:s:s:0 language=eng -metadata:s:s:1 language=fre \
    -disposition:a:0 default -disposition:a:1 0 \
    -disposition:s:0 0 -disposition:s:1 0 \
    -map_metadata -1 clip-languages.mkv
rm clip-fr.srt

cat > chapters.txt <<'META'
;FFMETADATA1
[CHAPTER]
TIMEBASE=1/1000
START=0
END=800
title=Opening
[CHAPTER]
TIMEBASE=1/1000
START=800
END=1400
title=Middle
[CHAPTER]
TIMEBASE=1/1000
START=1400
END=2000
title=End
META
"${ffmpeg[@]}" -i clip.mp4 -i chapters.txt -map 0 -c copy \
    -map_metadata 1 -map_chapters 1 clip-chapters.mkv
rm chapters.txt

# VobSub: an index, and a pack of MPEG-PS a cue, each holding the cue's
# subpicture: its run-length pixels, then when it shows and where.
python3 - <<'PY'
cues = [(0.2, 1.0, 96), (1.2, 1.9, 8)]  # start, end, top
width, height, left = 80, 16, 40


def pixel(x, y):
    # 1 white, 2 black, the outline a pixel wide.
    return 2 if x in (0, width - 1) or y in (0, height - 1) else 1


def line(y):
    nibbles, x = [], 0
    while x < width:
        color, run = pixel(x, y), 1
        while x + run < width and pixel(x + run, y) == color:
            run += 1
        v = run << 2 | color
        nibbles += [[v], [v >> 4, v & 15], [0, v >> 4, v & 15], [0, v >> 8, v >> 4 & 15, v & 15]][
            (run >= 4) + (run >= 16) + (run >= 64)
        ]
        x += run
    nibbles += [0] * (len(nibbles) % 2)
    return bytes(a << 4 | b for a, b in zip(nibbles[::2], nibbles[1::2]))


def subpicture(duration):
    top = b"".join(line(y) for y in range(0, height, 2))
    bottom = b"".join(line(y) for y in range(1, height, 2))
    first = 4 + len(top) + len(bottom)
    second = first + 24
    right, low = left + width - 1, cue_top + height - 1
    show = (
        (0).to_bytes(2, "big") + second.to_bytes(2, "big")
        + bytes([3, 0x32, 0x10, 4, 0xFF, 0xF0, 5])
        + bytes([left >> 4, (left & 15) << 4 | right >> 8, right & 255])
        + bytes([cue_top >> 4, (cue_top & 15) << 4 | low >> 8, low & 255])
        + bytes([6]) + (4).to_bytes(2, "big") + (4 + len(top)).to_bytes(2, "big")
        + bytes([1, 0xFF])
    )
    hide = round(duration * 90000 / 1024).to_bytes(2, "big") + second.to_bytes(2, "big") + bytes([2, 0xFF])
    body = top + bottom + show + hide
    return (4 + len(body)).to_bytes(2, "big") + first.to_bytes(2, "big") + body


def pack(pts, payload):
    scr = pts
    header = bytes([
        0, 0, 1, 0xBA,
        0x44 | (scr >> 27 & 0x38) | (scr >> 28 & 3), scr >> 20 & 255,
        (scr >> 12 & 0xF8) | 4 | (scr >> 13 & 3), scr >> 5 & 255, (scr << 3 & 0xF8) | 4, 1,
        0x01, 0x89, 0xC3, 0xF8,
    ])
    stamp = bytes([
        0x21 | (pts >> 29 & 0x0E), pts >> 22 & 255, (pts >> 14 & 0xFE) | 1,
        pts >> 7 & 255, (pts << 1 & 0xFE) | 1,
    ])
    data = bytes([0x81, 0x80, 5]) + stamp + bytes([0x20]) + payload
    pes = bytes([0, 0, 1, 0xBD]) + len(data).to_bytes(2, "big") + data
    rest = 2048 - len(header) - len(pes) - 6
    padding = bytes([0, 0, 1, 0xBE]) + rest.to_bytes(2, "big") + b"\xff" * rest
    return header + pes + padding


sub, index = b"", []
for start, end, cue_top in cues:
    index.append(f"timestamp: 00:00:{int(start):02}:{round(start % 1 * 1000):03}, filepos: {len(sub):09x}")
    sub += pack(round(start * 90000), subpicture(end - start))
palette = ", ".join(["000000", "ffffff", "000000", "808080"] + ["000000"] * 12)
with open("clip-dvdsub.sub", "wb") as f:
    f.write(sub)
with open("clip-dvdsub.idx", "w") as f:
    f.write("# VobSub index file, v7 (do not modify this line!)\n")
    f.write(f"size: 160x120\npalette: {palette}\n\nid: en, index: 0\n")
    f.write("\n".join(index) + "\n")
PY
"${ffmpeg[@]}" -i clip.mp4 -i clip-dvdsub.idx -map 0 -map 1 -c copy \
    -metadata:s:s:0 language=eng -metadata:s:s:0 title=English \
    -map_metadata -1 clip-dvdsub.mkv
rm clip-dvdsub.idx clip-dvdsub.sub

# FFmpeg won't write colors it has no names for, so the file is tagged
# with known ones and those are changed in its Colour element after. FFV1
# keeps no colors of its own, so the container's are what's read.
"${ffmpeg[@]}" -f lavfi -i "color=c=0x336699:size=160x120:rate=25:duration=2" \
    -vf "format=yuv420p10le,setparams=color_primaries=bt2020:color_trc=smpte2084:colorspace=bt2020nc" \
    -c:v ffv1 -g 25 -map_metadata -1 clip-odd-colors.mkv
python3 - <<'PY'
data = bytearray(open("clip-odd-colors.mkv", "rb").read())
colour = data.find(b"\x55\xb0")
assert colour >= 0 and data[colour + 2] & 0x80, "a Colour element"
end = colour + 3 + (data[colour + 2] & 0x7F)
# Primaries, TransferCharacteristics and MatrixCoefficients, a byte each.
for tag, value in [(b"\x55\xbb", 15), (b"\x55\xba", 40), (b"\x55\xb1", 30)]:
    at = data.find(tag, colour, end)
    assert at >= 0 and data[at + 2] == 0x81, tag.hex()
    data[at + 3] = value
open("clip-odd-colors.mkv", "wb").write(data)
PY

ls -l
