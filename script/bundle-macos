#!/usr/bin/env bash
# Build target/release/Plays.app. As an app, Plays can open files from
# Finder (Open With) and take files and folders dropped on its Dock icon.
#
# The app icon comes from assets/AppIcon.icon, made with Icon
# Composer; without it the app gets the generic icon. Compiling it takes
# Xcode 26 or later. The document icons come from resources/file-types.
#
# FFmpeg is built into the app (script/build-ffmpeg, which this runs the
# first time), so it runs on any Mac, with nothing else installed.
set -euo pipefail

cd "$(dirname "$0")/.."

script/build-ffmpeg
# The app's own FFmpeg, the one .cargo/config.toml names, even where
# FFMPEG_DIR names another.
unset FFMPEG_DIR
# The credits in Settings > About: FFmpeg, dav1d and GPUI as the app is
# built with them now.
script/attributions

version=$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -n 1)
icon=assets/AppIcon.icon
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

cargo build --release

app=target/release/Plays.app
plist="$app/Contents/Info.plist"
rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp target/release/plays "$app/Contents/MacOS/plays"
sed "s/@VERSION@/$version/g" resources/macos/Info.plist >"$plist"

if [ -d "$icon" ]; then
    # Assets.car holds the layered icon macOS 26 and later draw, AppIcon.icns
    # a flat one for older versions. actool also says which Info.plist keys
    # point at them.
    if ! xcrun actool "$icon" \
        --compile "$app/Contents/Resources" \
        --output-partial-info-plist "$work/icon.plist" \
        --app-icon AppIcon \
        --include-all-app-icons \
        --platform macosx \
        --target-device mac \
        --minimum-deployment-target "$(plutil -extract LSMinimumSystemVersion raw "$plist")" \
        --development-region en \
        --enable-on-demand-resources NO \
        --output-format human-readable-text \
        --warnings --errors >"$work/actool.log"; then
        cat "$work/actool.log" >&2
        exit 1
    fi
    grep -E ": (warning|error):" "$work/actool.log" >&2 || true
    if [ ! -f "$app/Contents/Resources/Assets.car" ]; then
        echo "actool made no icon from $icon" >&2
        exit 1
    fi
    /usr/libexec/PlistBuddy -c "Merge $work/icon.plist" "$plist" >/dev/null
else
    echo "No $icon, so the app gets the generic icon."
fi

# What Finder opens with Plays (script/file-types writes it), and the icon
# each format's files get when Plays is their default player.
/usr/libexec/PlistBuddy -c "Merge resources/macos/DocumentTypes.plist" "$plist" >/dev/null
cargo run -q --release -p file-types -- iconsets "$work/types"
for iconset in "$work"/types/*.iconset; do
    iconutil -c icns -o "$app/Contents/Resources/$(basename "$iconset" .iconset).icns" "$iconset"
done

plutil -lint "$plist" >/dev/null
# Sign the bundle as a whole (ad hoc), which seals Info.plist and the icon
# with the binary.
codesign --force --sign - "$app"

echo "Built $app"
echo "Move it to /Applications, or open it once, for Finder to offer it under Open With."
